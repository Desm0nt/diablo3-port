<!-- [D3] Gear (settings) dialog of Diablo III Mobile (DmActivity.showD3Settings). Simplified Chinese.
     The dialog can also be switched to a language other than the phone's (its own "Menu language" option). -->
<resources>
    <string name="d3_title">设置</string>
    <string name="d3_save">保存</string>
    <string name="d3_cancel">取消</string>
    <string name="d3_label_fmt">%1$s（%2$s）</string>
    <string name="d3_when_now">立即生效</string>
